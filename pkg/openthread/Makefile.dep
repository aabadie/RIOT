# deprecated module names, with hyphens
OPENTHREAD_DEPRECATED_MODULES = openthread-cli-ftd openthread-cli-mtd openthread-ftd \
                                openthread-mtd openthread-rcp
USEMODULE += $(subst -,_,$(filter $(OPENTHREAD_DEPRECATED_MODULES),$(USEMODULE)))

USEMODULE += event
USEMODULE += luid
USEMODULE += openthread_contrib
USEMODULE += random
USEMODULE += ztimer
USEMODULE += ztimer_msec
USEMODULE += ztimer_usec

# the radio is driven through the IEEE 802.15.4 Radio HAL, not netdev
DISABLE_MODULE += auto_init_at86rf2xx

# radios that don't send the ACKs of the received frames themselves (the
# radios for which the SubMac of RIOT uses ieee802154_submac_soft_ack)
ifneq (,$(filter nrf802154 socket_zep,$(USEMODULE)))
  USEMODULE += openthread_soft_ack
endif

ifneq (,$(filter kw2xrf mrf24j40,$(USEMODULE)))
  USEMODULE += bhp_event
endif

ifneq (,$(filter openthread_cli_%,$(USEMODULE)))
  USEMODULE += shell_cmds_default
endif

ifneq (,$(filter openthread_border_router,$(USEMODULE)))
  ifeq (,$(filter openthread_ftd,$(USEMODULE)))
    $(error openthread_border_router needs openthread_ftd)
  endif
  # IPv6 and stdio over ethos, as gnrc_border_router
  USEMODULE += ethos
  USEMODULE += stdio_ethos
  USEMODULE += inet_csum
endif

ifneq (,$(filter openthread_rcp,$(USEMODULE)))
  # spinel over HDLC on a UART, see OPENTHREAD_RCP_UART_DEV
  FEATURES_REQUIRED += periph_uart
  USEMODULE += tsrb
endif

FEATURES_REQUIRED += cpp
